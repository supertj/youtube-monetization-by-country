    }
  ],
  "keywords": [
    "youtube",
    "monetization",
    "youtube partner program",
    "creator economy",
    "by country",
    "advertising",
    "media"
  ],
  "version": "2026.10.19",
  "resources": [
    {
      "name": "youtube-monetization-signals-by-country",
      "profile": "tabular-data-resource",
      "path": "youtube-monetization-signals-by-country.csv",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "schema": {
        "fields": [
          {
            "name": "country_code",
            "type": "string",
            "description": "ISO 3166-1 alpha-2 country code"
          },
          {
            "name": "country",
            "type": "string",
            "description": "English country name"
          },
          {
            "name": "channels_checked",
            "type": "integer",
            "description": "Sample size for the row"
          },
          {
            "name": "likely_monetized",
            "type": "integer",
            "description": "Channels showing Partner Program signals"
          },
          {
            "name": "possibly_monetized",
            "type": "integer",
            "description": "Mixed or partial signals"
          },
          {
            "name": "likely_not_monetized",
            "type": "integer",
            "description": "Signals consistently absent"
          },
          {
            "name": "unable_to_determine",
            "type": "integer",
            "description": "Not enough readable signal to call"
          },
          {
            "name": "median_subscribers",
            "type": "integer",
            "description": "Median subscriber count of channels checked. Empty from the October 2026 snapshot on."
          }
        ]
      }
    }
  ]
}
