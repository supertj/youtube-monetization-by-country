{
  "profile": "tabular-data-package",
  "name": "youtube-monetization-signals-by-country",
  "title": "YouTube monetization signals by country",
  "description": "How often YouTube channels in each country show the public signals of a channel in the YouTube Partner Program. October 2026 snapshot: 51 countries, 4,514 channels checked, recomputed on 19 October 2026. Includes the share that could not be determined. The scoring rule and the sample have changed since the September 2026 snapshot; see the changelog in README.md.",
  "homepage": "https://monetizationkit.com/data/youtube-monetized-channels-by-country/",
